# Copie para .env.local: cp .env.example .env.local
#
# URL da API do Spring. NEXT_PUBLIC_ significa que o valor vai pro bundle e
# fica visível no navegador — o que é correto aqui (é um endereço, não
# segredo). NUNCA prefixe com NEXT_PUBLIC_ algo que precise ficar escondido.
NEXT_PUBLIC_API_URL=http://localhost:8080
