# Copie para .env e preencha com valores reais: cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser commitado.

# --- Postgres (lido pelo docker-compose.yml) ---
POSTGRES_USER=simulados
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=simulados

# --- Aplicação Spring (lido pelo application.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/simulados
DB_USER=simulados
DB_PASSWORD=troque-esta-senha

# --- JWT (será usado quando implementarmos autenticação) ---
# JWT_SECRET=gere-um-segredo-forte-com-openssl-rand-base64-64
