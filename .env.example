# Copie para .env e preencha com valores reais: cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser commitado.

# --- Postgres (lido pelo docker-compose.yml) ---
POSTGRES_USER=simulados
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=simulados
# Porta no host. 5433 evita conflito com um Postgres instalado no sistema.
# Se mudar aqui, mude também a porta do DB_URL abaixo.
POSTGRES_PORT=5433

# --- Aplicação Spring (lido pelo application.yml) ---
DB_URL=jdbc:postgresql://localhost:5433/simulados
DB_USER=simulados
DB_PASSWORD=troque-esta-senha

# --- JWT ---
# Mínimo 32 bytes. Gere o seu com: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=troque-por-um-segredo-gerado-com-openssl-rand-base64-64
