meta {
  name: 12 - Tentativa alheia ou inexistente (404)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/tentativas/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 404
}

docs {
  Mesma regra dos simulados: a tentativa de outro aluno é indistinguível de
  uma que não existe.
}
