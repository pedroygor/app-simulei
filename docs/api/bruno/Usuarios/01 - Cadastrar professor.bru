meta {
  name: 01 - Cadastrar professor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Professor Teste",
    "email": "{{email}}",
    "senha": "{{senha}}",
    "role": "PROFESSOR"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
  email: john.doe@email.com
  senha: senha-sempre-forte@123
}

tests {
  test("cria o professor, ou 409 se ele já existir de uma rodada anterior", function() {
    expect([201, 409]).to.include(res.getStatus());
  });
}

docs {
  Endpoint PÚBLICO. Cria o usuário usado pelos demais requests.
  
  201 Created + header Location: /usuarios/{id}
  A resposta NUNCA traz senhaHash — o DTO de saída não tem esse campo.
  
  Rodar duas vezes devolve 409 (ver request "05 - Cadastrar duplicado").
}
