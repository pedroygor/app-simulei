meta {
  name: 02 - Cadastrar aluno
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Aluno Teste",
    "email": "aluno@teste.com",
    "senha": "senha-forte-123",
    "role": "ALUNO"
  }
}

tests {
  test("cria o aluno, ou 409 se ele já existir de uma rodada anterior", function() {
    expect([201, 409]).to.include(res.getStatus());
  });
}

docs {
  Mesmo endpoint, role ALUNO. Todo usuário nasce com plano FREE e ativo=true —
  esses campos são default da entidade, não vêm do payload.
}
